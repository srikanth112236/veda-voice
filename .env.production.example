# ==============================================================================
# VEDAVOICE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Reference: docs/SRS.md Appendix B
# Never commit actual secret values into git. Store all secrets in Azure Key Vault.
# ==============================================================================

# API & Networking
API_TITLE="VedaVoice API"
API_VERSION="1.0.0"
API_BASE_URL="https://api.vedavoice.io"
APP_BASE_URL="https://app.vedavoice.io"
CORS_ORIGINS=["https://app.vedavoice.io","https://admin.vedavoice.io"]

# Database (PostgreSQL Flexible Server with SSL)
DATABASE_URL="postgresql+psycopg://vaadmin:<PROD_PASSWORD>@pg-vagency-prod.postgres.database.azure.com:5432/vedavoice?sslmode=require"

# Security & Tokens (Minimum 32 random bytes/chars)
JWT_SECRET="<CHANGE_ME_PRODUCTION_JWT_SECRET_32_CHARS>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INTERNAL_SIGNING_KEY="<CHANGE_ME_PRODUCTION_INTERNAL_SIGNING_KEY_32_CHARS>"
ENCRYPTION_KEY_ID="kv-vagency-prod-key"
ENCRYPTION_SECRET="<CHANGE_ME_ENVELOPE_ENCRYPTION_SECRET_32_CHARS>"

# Super Admin Initial Credentials
PLATFORM_ADMIN_EMAIL="admin@vedavoice.io"
PLATFORM_ADMIN_PASSWORD="<CHANGE_ME_SECURE_ADMIN_PASSWORD>"
PLATFORM_ADMIN_NAME="Platform Administrator"

# Capacity & Concurrency Limits
GLOBAL_MAX_CONCURRENT=40
GLOBAL_MAX_OUTBOUND=10

# LiveKit Cloud Project & Telephony
LIVEKIT_URL="wss://<your-project-id>.livekit.cloud"
LIVEKIT_API_KEY="<LIVEKIT_API_KEY>"
LIVEKIT_API_SECRET="<LIVEKIT_API_SECRET>"
LIVEKIT_SIP_INBOUND_TRUNK_ID="ST_inbound_livekit_scale"
LIVEKIT_SIP_OUTBOUND_TRUNK_ID="ST_outbound_twilio_elastic"
LIVEKIT_SIP_DISPATCH_RULE_NAME="all-tenants-inbound"
CARRIER_PRIMARY_PROVIDER="Twilio Elastic SIP Trunk"

# Google Calendar OAuth 2.0 Integration
GOOGLE_CLIENT_ID="<GOOGLE_OAUTH_CLIENT_ID>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<GOOGLE_OAUTH_CLIENT_SECRET>"
GOOGLE_REDIRECT_URI="https://api.vedavoice.io/api/v1/portal/calendar/callback"

# HubSpot OAuth Integration
HUBSPOT_CLIENT_ID="<HUBSPOT_CLIENT_ID>"
HUBSPOT_CLIENT_SECRET="<HUBSPOT_CLIENT_SECRET>"
HUBSPOT_REDIRECT_URI="https://api.vedavoice.io/api/v1/integrations/hubspot/callback"

# GoHighLevel Integration
GHL_CLIENT_ID="<GHL_CLIENT_ID>"
GHL_CLIENT_SECRET="<GHL_CLIENT_SECRET>"
GHL_REDIRECT_URI="https://api.vedavoice.io/api/v1/integrations/gohighlevel/callback"

# Pipedrive Integration
PIPEDRIVE_CLIENT_ID="<PIPEDRIVE_CLIENT_ID>"
PIPEDRIVE_CLIENT_SECRET="<PIPEDRIVE_CLIENT_SECRET>"
PIPEDRIVE_REDIRECT_URI="https://api.vedavoice.io/api/v1/integrations/pipedrive/callback"

# Meta (Facebook & Instagram) Lead Ads
META_VERIFY_TOKEN="<RANDOM_VERIFY_TOKEN>"
META_APP_SECRET="<META_APP_SECRET>"

# Notifications (Email & SMS)
NOTIFICATION_ENABLED=True
RESEND_API_KEY="<re_your_resend_api_key>"
RESEND_FROM_EMAIL="alerts@updates.vedasynk.com"
SENDGRID_API_KEY=""
TWILIO_ACCOUNT_SID="<AC_TWILIO_SID>"
TWILIO_AUTH_TOKEN="<TWILIO_AUTH_TOKEN>"
TWILIO_FROM_NUMBER="+18005550199"

# Stripe Billing & Subscriptions
STRIPE_SECRET_KEY="<sk_live_...>"
STRIPE_WEBHOOK_SECRET="<whsec_...>"
STRIPE_PUBLISHABLE_KEY="<pk_live_...>"
