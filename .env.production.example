# ==============================================================================
# VEDAVOICE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# File: .env.production.example
# Reference: docs/SRS.md Appendix B & docs/AZURE_DEPLOYMENT_GUIDE.md
#
# SECURITY MANDATE (AGENTS.md):
# Never commit real secret values into git. Store all production secrets in 
# Azure Key Vault (kv-vagency-prod-6eac) and LiveKit Cloud Agent Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORKING & SYSTEM IDENTIFIERS
# ------------------------------------------------------------------------------
API_TITLE="VedaVoice API"
API_VERSION="1.0.0"
API_BASE_URL="https://api.kindstone-eaab21b4.eastus2.azurecontainerapps.io"
APP_BASE_URL="https://dashboard.kindstone-eaab21b4.eastus2.azurecontainerapps.io"
NEXT_PUBLIC_API_URL="https://api.kindstone-eaab21b4.eastus2.azurecontainerapps.io"
CORS_ORIGINS=["https://dashboard.kindstone-eaab21b4.eastus2.azurecontainerapps.io","https://api.kindstone-eaab21b4.eastus2.azurecontainerapps.io"]

# ------------------------------------------------------------------------------
# 2. DATABASE & STORAGE (PostgreSQL 16 Flexible Server with SSL)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql+psycopg://vaadmin:<POSTGRES_PASSWORD>@pg-vagency-prod-1459.postgres.database.azure.com:5432/vedavoice?sslmode=require"
AZURE_STORAGE_ACCOUNT="stvagencyprod6eac3"
AZURE_STORAGE_CONTAINER="recordings"

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY (Minimum 32 random bytes/chars)
# ------------------------------------------------------------------------------
JWT_SECRET="<PRODUCTION_JWT_SECRET_32_BYTES_MIN>"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INTERNAL_SIGNING_KEY="<PRODUCTION_INTERNAL_SIGNING_KEY_32_BYTES_MIN>"
ENCRYPTION_KEY_ID="kv-vagency-prod-key"
ENCRYPTION_SECRET="<PRODUCTION_ENVELOPE_ENCRYPTION_SECRET_32_BYTES_MIN>"

# ------------------------------------------------------------------------------
# 4. INITIAL PLATFORM ADMINISTRATOR
# ------------------------------------------------------------------------------
PLATFORM_ADMIN_EMAIL="admin@vedavoice.io"
PLATFORM_ADMIN_PASSWORD="<STRONG_PRODUCTION_ADMIN_PASSWORD>"
PLATFORM_ADMIN_NAME="Platform Administrator"

# ------------------------------------------------------------------------------
# 5. CONCURRENCY & CALL LIMITS
# ------------------------------------------------------------------------------
GLOBAL_MAX_CONCURRENT=40
GLOBAL_MAX_OUTBOUND=10

# ------------------------------------------------------------------------------
# 6. LIVEKIT CLOUD & VOICE PIPELINE (Voice Receptionist Agent)
# ------------------------------------------------------------------------------
LIVEKIT_URL="wss://<your-project-id>.livekit.cloud"
LIVEKIT_API_KEY="<LIVEKIT_API_KEY>"
LIVEKIT_API_SECRET="<LIVEKIT_API_SECRET>"
LLM_MODEL="google/gemini-2.5-flash"
STT_MODEL="deepgram/nova-3"
TTS_MODEL="inworld/inworld-tts-1"
TTS_VOICE_ID="Alex"
GOOGLE_API_KEY="<GOOGLE_AI_STUDIO_API_KEY>"
DEEPGRAM_API_KEY="<DEEPGRAM_API_KEY>"
INWORLD_API_KEY="<INWORLD_API_KEY>"
VAD_MIN_SILENCE_DURATION=0.38
VAD_PREFIX_PADDING_DURATION=0.30

# ------------------------------------------------------------------------------
# 7. TELEPHONY & SIP TRUNKING
# ------------------------------------------------------------------------------
CARRIER_PRIMARY_PROVIDER="Twilio Elastic SIP Trunk"
CARRIER_HOT_STANDBY_PROVIDER="Telnyx SIP (Hot Standby)"
LIVEKIT_SIP_INBOUND_TRUNK_ID="ST_inbound_livekit_scale"
LIVEKIT_SIP_OUTBOUND_TRUNK_ID="ST_outbound_twilio_elastic"
LIVEKIT_SIP_DISPATCH_RULE_NAME="all-tenants-inbound"
TWILIO_ACCOUNT_SID="<AC_TWILIO_ACCOUNT_SID>"
TWILIO_AUTH_TOKEN="<TWILIO_AUTH_TOKEN>"
TWILIO_FROM_NUMBER="+18005550199"

# ------------------------------------------------------------------------------
# 8. NOTIFICATIONS & EMAIL
# ------------------------------------------------------------------------------
NOTIFICATION_ENABLED=True
EMAIL_PROVIDER="resend"
RESEND_API_KEY="<re_your_resend_api_key>"
RESEND_FROM_EMAIL="alerts@updates.vedasynk.com"
SENDGRID_API_KEY=""

# ------------------------------------------------------------------------------
# 9. STRIPE BILLING & SUBSCRIPTIONS (Milestone M5c)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="<sk_live_...>"
STRIPE_WEBHOOK_SECRET="<whsec_...>"
STRIPE_PUBLISHABLE_KEY="<pk_live_...>"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="<pk_live_...>"

# ------------------------------------------------------------------------------
# 10. CRM & CALENDAR OAUTH INTEGRATIONS
# ------------------------------------------------------------------------------
# Google Calendar
GOOGLE_CLIENT_ID="<GOOGLE_OAUTH_CLIENT_ID>.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="<GOOGLE_OAUTH_CLIENT_SECRET>"
GOOGLE_REDIRECT_URI="https://api.kindstone-eaab21b4.eastus2.azurecontainerapps.io/api/v1/portal/calendar/callback"

# HubSpot CRM
HUBSPOT_CLIENT_ID="<HUBSPOT_CLIENT_ID>"
HUBSPOT_CLIENT_SECRET="<HUBSPOT_CLIENT_SECRET>"
HUBSPOT_REDIRECT_URI="https://api.kindstone-eaab21b4.eastus2.azurecontainerapps.io/api/v1/integrations/hubspot/callback"

# GoHighLevel (GHL)
GHL_CLIENT_ID="<GHL_CLIENT_ID>"
GHL_CLIENT_SECRET="<GHL_CLIENT_SECRET>"
GHL_REDIRECT_URI="https://api.kindstone-eaab21b4.eastus2.azurecontainerapps.io/api/v1/integrations/gohighlevel/callback"

# Pipedrive CRM
PIPEDRIVE_CLIENT_ID="<PIPEDRIVE_CLIENT_ID>"
PIPEDRIVE_CLIENT_SECRET="<PIPEDRIVE_CLIENT_SECRET>"
PIPEDRIVE_REDIRECT_URI="https://api.kindstone-eaab21b4.eastus2.azurecontainerapps.io/api/v1/integrations/pipedrive/callback"

# Meta (Facebook & Instagram) Lead Ads
META_VERIFY_TOKEN="<RANDOM_VERIFY_TOKEN_32_CHARS>"
META_APP_SECRET="<META_APP_SECRET>"

# ------------------------------------------------------------------------------
# 11. AZURE INFRASTRUCTURE & GITHUB ACTIONS CI/CD IDENTIFIERS
# ------------------------------------------------------------------------------
AZURE_CLIENT_ID="d9176377-3732-42c3-baf0-207228f8e1b8"
AZURE_TENANT_ID="7db59690-0fea-4c9a-8eaa-ad2546922380"
AZURE_SUBSCRIPTION_ID="88012ee9-1305-42dc-9a29-8d2905cb2415"
AZURE_RG="rg-vagency-prod"
ACR_NAME="acrvagencyprod6eac3"
PROD_API_URL="https://api.kindstone-eaab21b4.eastus2.azurecontainerapps.io"
AZURE_KEYVAULT_URI="https://kv-vagency-prod-6eac.vault.azure.net/"
LIVEKIT_ACCESS_TOKEN="<LIVEKIT_CLI_TOKEN_FROM_LK_CLOUD_AUTH>"
