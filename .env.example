# ==============================================================================
# VEDAVOICE ROOT ENVIRONMENT TEMPLATE
# For local development: see .env.development.example
# For Azure production:  see .env.production.example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NETWORKING & SYSTEM IDENTIFIERS
# ------------------------------------------------------------------------------
API_TITLE="VedaVoice API (Dev)"
API_VERSION="0.1.0-dev"
API_BASE_URL="http://localhost:8000"
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ------------------------------------------------------------------------------
# 2. DATABASE & STORAGE (Local SQLite or Local Docker PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL="sqlite:///data/vagency.db"
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_CONTAINER="recordings-dev"

# ------------------------------------------------------------------------------
# 3. SECURITY & CRYPTOGRAPHY (Local Dev Safe Mock Keys)
# ------------------------------------------------------------------------------
JWT_SECRET="fake-local-dev-jwt-secret-not-for-prod-use-minimum-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INTERNAL_SIGNING_KEY="fake-local-dev-signing-key-not-for-prod-32bytes-min"
ENCRYPTION_KEY_ID="fake-local-dev-encryption-key"
ENCRYPTION_SECRET="envelope-secret-key-vedavoice-32bytes-min!"

# ------------------------------------------------------------------------------
# 4. INITIAL PLATFORM ADMINISTRATOR (Local Dev Seed)
# ------------------------------------------------------------------------------
PLATFORM_ADMIN_EMAIL="admin@vedavoice.io"
PLATFORM_ADMIN_PASSWORD="Admin@VedaVoice2026!"
PLATFORM_ADMIN_NAME="VedaVoice Platform Admin (Dev)"

# ------------------------------------------------------------------------------
# 5. CONCURRENCY & CALL LIMITS
# ------------------------------------------------------------------------------
GLOBAL_MAX_CONCURRENT=10
GLOBAL_MAX_OUTBOUND=5

# ------------------------------------------------------------------------------
# 6. LIVEKIT CLOUD & VOICE PIPELINE (Voice Receptionist Agent)
# ------------------------------------------------------------------------------
LIVEKIT_URL="wss://<your-dev-project>.livekit.cloud"
LIVEKIT_API_KEY="dev_livekit_api_key"
LIVEKIT_API_SECRET="dev_livekit_api_secret"
LLM_MODEL="google/gemini-2.5-flash"
STT_MODEL="deepgram/nova-3"
TTS_MODEL="inworld/inworld-tts-1"
TTS_VOICE_ID="Alex"
GOOGLE_API_KEY="<YOUR_DEV_GOOGLE_AI_STUDIO_API_KEY>"
DEEPGRAM_API_KEY="<YOUR_DEV_DEEPGRAM_API_KEY>"
INWORLD_API_KEY="<YOUR_DEV_INWORLD_API_KEY>"
VAD_MIN_SILENCE_DURATION=0.38
VAD_PREFIX_PADDING_DURATION=0.30

# ------------------------------------------------------------------------------
# 7. TELEPHONY & SIP TRUNKING
# ------------------------------------------------------------------------------
CARRIER_PRIMARY_PROVIDER="Twilio Elastic SIP Trunk"
CARRIER_HOT_STANDBY_PROVIDER="Telnyx SIP (Hot Standby)"
LIVEKIT_SIP_INBOUND_TRUNK_ID="ST_inbound_dev"
LIVEKIT_SIP_OUTBOUND_TRUNK_ID="ST_outbound_dev"
LIVEKIT_SIP_DISPATCH_RULE_NAME="dev-tenants-inbound"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER="+18005550199"

# ------------------------------------------------------------------------------
# 8. NOTIFICATIONS & EMAIL
# ------------------------------------------------------------------------------
NOTIFICATION_ENABLED=False
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="alerts@updates.vedasynk.com"
SENDGRID_API_KEY=""

# ------------------------------------------------------------------------------
# 9. STRIPE BILLING & SUBSCRIPTIONS (Test Mode)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ------------------------------------------------------------------------------
# 10. CRM & CALENDAR OAUTH INTEGRATIONS
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/portal/calendar/callback"

HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:8000/api/v1/integrations/hubspot/callback"

GHL_CLIENT_ID=""
GHL_CLIENT_SECRET=""
GHL_REDIRECT_URI="http://localhost:8000/api/v1/integrations/gohighlevel/callback"

PIPEDRIVE_CLIENT_ID=""
PIPEDRIVE_CLIENT_SECRET=""
PIPEDRIVE_REDIRECT_URI="http://localhost:8000/api/v1/integrations/pipedrive/callback"

META_VERIFY_TOKEN="vedavoice_meta_verify_token_dev"
META_APP_SECRET=""

# ------------------------------------------------------------------------------
# 11. AZURE INFRASTRUCTURE & GITHUB ACTIONS CI/CD IDENTIFIERS
# ------------------------------------------------------------------------------
AZURE_CLIENT_ID=""
AZURE_TENANT_ID=""
AZURE_SUBSCRIPTION_ID=""
AZURE_RG=""
ACR_NAME=""
PROD_API_URL="http://localhost:8000"
AZURE_KEYVAULT_URI=""
LIVEKIT_ACCESS_TOKEN=""
