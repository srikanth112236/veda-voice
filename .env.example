# LiveKit
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# Agent -> API
API_BASE_URL=http://localhost:8000
INTERNAL_SIGNING_KEY=fake-local-dev-signing-key-not-for-prod-32bytes-min

# Database (Local Docker Dev)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=fake-local-dev-postgres-password
POSTGRES_DB=vagency
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:fake-local-dev-postgres-password@127.0.0.1:5432/vagency

# Auth and app
JWT_SECRET=fake-local-dev-jwt-secret-not-for-prod-use
APP_BASE_URL=http://localhost:3000
ENCRYPTION_KEY_ID=fake-local-dev-encryption-key            # Key Vault key reference in cloud; local dev key only in dev

# Carrier
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=            # or TELNYX_API_KEY

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/integrations/google/callback

# Email
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=notifications@example.com

# Limits
GLOBAL_MAX_CONCURRENT=40
GLOBAL_MAX_OUTBOUND=10
